{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sgaeia/schemas/integration-port.schema.json",
  "title": "SGAEIA Integration Port Specification",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "sgaeia.io/v1alpha1"
    },
    "kind": {
      "const": "IntegrationPort"
    },
    "metadata": {
      "type": "object",
      "required": [
        "id",
        "name",
        "version",
        "owner"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^IP-[A-Z0-9-]+$"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "criticality": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        }
      }
    },
    "spec": {
      "type": "object",
      "required": [
        "purpose",
        "protocolStyle",
        "contracts",
        "failureMode",
        "revocation",
        "evidence"
      ],
      "properties": {
        "purpose": {
          "type": "string"
        },
        "protocolStyle": {
          "enum": [
            "http",
            "event",
            "library",
            "sidecar",
            "control-plane",
            "storage",
            "hybrid"
          ]
        },
        "contracts": {
          "type": "object",
          "required": [
            "functional",
            "security",
            "audit",
            "failure",
            "revocation"
          ],
          "properties": {
            "functional": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "security": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "audit": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "failure": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "revocation": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          }
        },
        "failureMode": {
          "enum": [
            "fail-closed",
            "degrade-authority",
            "buffer-and-retry",
            "read-only",
            "domain-specific"
          ]
        },
        "revocation": {
          "type": "object",
          "required": [
            "supported",
            "maxPropagationSeconds"
          ],
          "properties": {
            "supported": {
              "const": true
            },
            "maxPropagationSeconds": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "evidence": {
          "type": "object",
          "required": [
            "required",
            "fields"
          ],
          "properties": {
            "required": {
              "const": true
            },
            "fields": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "string"
              }
            }
          }
        },
        "interfaces": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "referenceAdapters": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
