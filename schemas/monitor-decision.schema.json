{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sgaeia.dev/schemas/monitor-decision.schema.json",
  "title": "SGAEIA Independent Monitor Decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["monitor_id", "subject_agent_id", "trace_id", "operation", "resource", "allow", "valid", "policy_version", "issued_at", "expires_at", "signature_valid", "trust_domain"],
  "properties": {
    "monitor_id": {"type": "string", "minLength": 1},
    "subject_agent_id": {"type": "string", "minLength": 1},
    "trace_id": {"type": "string", "minLength": 1},
    "operation": {"type": "string", "minLength": 1},
    "resource": {"type": "string", "minLength": 1},
    "allow": {"type": "boolean"},
    "valid": {"type": "boolean"},
    "policy_version": {"type": "string", "minLength": 1},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "signature_valid": {"const": true},
    "trust_domain": {"type": "string", "minLength": 1}
  }
}
