{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Intent",
  "type": "object",
  "required": [
    "agent_id",
    "operation",
    "resource",
    "trace_id"
  ],
  "properties": {
    "agent_id": {
      "type": "string"
    },
    "operation": {
      "type": "string"
    },
    "resource": {
      "type": "string"
    },
    "trace_id": {
      "type": "string"
    },
    "delegation_depth": {
      "type": "integer",
      "minimum": 0
    },
    "offline": {
      "type": "boolean"
    },
    "physical_actuation": {
      "type": "boolean"
    },
    "human_approvals": {
      "type": "integer",
      "minimum": 0
    }
  }
}
