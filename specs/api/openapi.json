{
  "openapi": "3.1.0",
  "info": {
    "title": "SGAEIA Control API",
    "version": "0.3.2-rc2"
  },
  "paths": {
    "/health": {
      "get": {
        "responses": {
          "200": {"description": "healthy"}
        }
      }
    },
    "/v1/authorize": {
      "post": {
        "summary": "Evaluate an agent intent using server-resolved assurance context",
        "description": "Security-relevant classification, risk, monitoring, approvals and runtime counters are resolved by the trusted control plane and are not accepted from the requesting agent.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/AuthorizationRequest"}
            }
          }
        },
        "responses": {
          "200": {"description": "Policy decision and evidence"},
          "422": {"description": "Untrusted or unknown request fields"}
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuthorizationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["agent_id", "operation", "resource", "trace_id"],
        "properties": {
          "agent_id": {"type": "string", "minLength": 1},
          "operation": {"type": "string", "minLength": 1},
          "resource": {"type": "string", "minLength": 1},
          "trace_id": {"type": "string", "minLength": 1},
          "delegation_chain": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "default": []
          }
        }
      }
    }
  }
}
